{
	"cli": {
		"version": ">= 20.1.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"channel": "development",
			"env": {
				"APP_VARIANT": "development"
			},
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"channel": "preview",
			"env": {
				"APP_VARIANT": "preview"
			},
			"distribution": "internal"
		},
		"production": {
			"channel": "production",
			"env": {
				"APP_VARIANT": "production"
			},
			"autoIncrement": true
		}
	},
	"submit": {
		"production": {}
	}
}
